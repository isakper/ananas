# Environment variables (copy to .env and fill in)

# App
APP_ENV=development
APP_NAME=standard-template-with-agents

# Server
HOST=127.0.0.1
PORT=8000

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Observability
LOG_LEVEL=info
