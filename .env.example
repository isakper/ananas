# Environment variables (copy to .env and fill in)

# App
APP_ENV=development
APP_NAME=standard-template-with-agents

# Server
HOST=127.0.0.1
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5433

# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-sonnet-4-5
LLM_SSL_VERIFY=true

# Database
DATABASE_URL=postgresql://app:app@localhost:5433/app

# Observability
LOG_LEVEL=info
