#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

database_url="${DATABASE_URL:-postgresql://app:app@postgres:5432/app}"

run_psql() {
  psql "$database_url" -v ON_ERROR_STOP=1 "$@"
}

migration_recorded() {
  local name="$1"
  local result
  result="$(run_psql -Atq -c "SELECT 1 FROM schema_migrations WHERE name = '${name}' LIMIT 1;")"
  [[ "$result" == "1" ]]
}

mark_migration() {
  local name="$1"
  run_psql -c "INSERT INTO schema_migrations (name) VALUES ('${name}') ON CONFLICT (name) DO NOTHING;" >/dev/null
}

bootstrap_legacy_migrations() {
  if ! migration_recorded "0001_initial_schema.sql"; then
    local schema_ready
    schema_ready="$(run_psql -Atq -c "SELECT to_regclass('public.accounts') IS NOT NULL AND to_regclass('public.invoices') IS NOT NULL AND to_regclass('public.journal_entries') IS NOT NULL AND to_regclass('public.journal_postings') IS NOT NULL;")"
    if [[ "$schema_ready" == "t" ]]; then
      mark_migration "0001_initial_schema.sql"
      echo "[db-migrate-direct] Bootstrapped 0001_initial_schema.sql"
    fi
  fi

  if ! migration_recorded "0002_seed_accounts.sql"; then
    local accounts_table_exists
    accounts_table_exists="$(run_psql -Atq -c "SELECT to_regclass('public.accounts') IS NOT NULL;")"
    if [[ "$accounts_table_exists" == "t" ]]; then
      local has_seed
      has_seed="$(run_psql -Atq -c "SELECT EXISTS(SELECT 1 FROM accounts WHERE code = 1930);")"
      if [[ "$has_seed" == "t" ]]; then
        mark_migration "0002_seed_accounts.sql"
        echo "[db-migrate-direct] Bootstrapped 0002_seed_accounts.sql"
      fi
    fi
  fi

  if ! migration_recorded "0003_invoice_generation_status.sql"; then
    local invoices_table_exists
    invoices_table_exists="$(run_psql -Atq -c "SELECT to_regclass('public.invoices') IS NOT NULL;")"
    if [[ "$invoices_table_exists" == "t" ]]; then
      local has_generation_status
      has_generation_status="$(run_psql -Atq -c "SELECT EXISTS(SELECT 1 FROM information_schema.columns WHERE table_schema = 'public' AND table_name = 'invoices' AND column_name = 'generation_status');")"
      if [[ "$has_generation_status" == "t" ]]; then
        mark_migration "0003_invoice_generation_status.sql"
        echo "[db-migrate-direct] Bootstrapped 0003_invoice_generation_status.sql"
      fi
    fi
  fi
}

run_psql -c "CREATE TABLE IF NOT EXISTS schema_migrations (name TEXT PRIMARY KEY, applied_at TIMESTAMPTZ NOT NULL DEFAULT NOW());"
bootstrap_legacy_migrations

mapfile -t migrations < <(find backend/db/migrations -maxdepth 1 -type f -name '*.sql' | sort)
for migration in "${migrations[@]}"; do
  migration_name="$(basename "$migration")"
  if migration_recorded "$migration_name"; then
    echo "[db-migrate-direct] Skipping ${migration_name} (already applied)"
    continue
  fi
  run_psql -f "$migration"
  mark_migration "$migration_name"
  echo "[db-migrate-direct] Applied ${migration_name}"
done

echo "[db-migrate-direct] Migrations applied"
